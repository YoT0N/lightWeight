<%- include('layout') %>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card shadow-lg">
            <div class="card-body text-center p-4">
                <div class="mb-3">
                    <i class="fas fa-user-circle fa-5x text-primary"></i>
                </div>
                <h4 class="fw-bold"><%= user.name %></h4>
                <p class="text-muted"><%= user.email %></p>

                <div
                    class="badge bg-<%= user.role === 'admin' ? 'danger' : 'primary' %> mb-3"
                >
                    <i
                        class="fas fa-<%= user.role === 'admin' ? 'crown' : 'user' %> me-1"
                    ></i>
                    <%= user.role === 'admin' ? 'Адміністратор' : 'Користувач'
                    %>
                </div>

                <div class="d-grid gap-2">
                    <a href="/chat" class="btn btn-success">
                        <i class="fas fa-comments me-2"></i>
                        Перейти до чату
                    </a>
                    <button
                        class="btn btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#editProfileModal"
                    >
                        <i class="fas fa-edit me-2"></i>
                        Редагувати профіль
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-lg">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Інформація про профіль
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Ім'я:</label>
                        <p class="form-control-plaintext"><%= user.name %></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Email:</label>
                        <p class="form-control-plaintext"><%= user.email %></p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Вік:</label>
                        <p class="form-control-plaintext">
                            <%= user.age %> років
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Роль:</label>
                        <p class="form-control-plaintext">
                            <span
                                class="badge bg-<%= user.role === 'admin' ? 'danger' : 'primary' %>"
                            >
                                <%= user.role === 'admin' ? 'Адміністратор' :
                                'Користувач' %>
                            </span>
                        </p>
                    </div>
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold"
                            >Дата реєстрації:</label
                        >
                        <p class="form-control-plaintext">
                            <%= new
                            Date(user.createdAt).toLocaleDateString('uk-UA', {
                            year: 'numeric', month: 'long', day: 'numeric',
                            hour: '2-digit', minute: '2-digit' }) %>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Статистика -->
        <div class="card shadow-lg mt-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar me-2"></i>
                    Статистика активності
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <i
                                    class="fas fa-comments fa-2x text-primary mb-2"
                                ></i>
                                <h5 class="fw-bold">0</h5>
                                <p class="text-muted mb-0">Повідомлень</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <i
                                    class="fas fa-clock fa-2x text-info mb-2"
                                ></i>
                                <h5 class="fw-bold">Online</h5>
                                <p class="text-muted mb-0">Статус</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <i
                                    class="fas fa-calendar fa-2x text-success mb-2"
                                ></i>
                                <h5 class="fw-bold">
                                    <%= Math.floor((Date.now() - new
                                    Date(user.createdAt)) / (1000 * 60 * 60 *
                                    24)) %>
                                </h5>
                                <p class="text-muted mb-0">Днів з нами</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальне вікно редагування профілю -->
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-edit me-2"></i>
                    Редагувати профіль
                </h5>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button>
            </div>
            <form id="editProfileForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editName" class="form-label">Ім'я</label>
                        <input
                            type="text"
                            class="form-control"
                            id="editName"
                            name="name"
                            value="<%= user.name %>"
                            required
                        />
                    </div>
                    <div class="mb-3">
                        <label for="editAge" class="form-label">Вік</label>
                        <input
                            type="number"
                            class="form-control"
                            id="editAge"
                            name="age"
                            value="<%= user.age %>"
                            min="1"
                            max="120"
                            required
                        />
                    </div>
                    <div class="mb-3">
                        <label for="editEmail" class="form-label">Email</label>
                        <input
                            type="email"
                            class="form-control"
                            id="editEmail"
                            name="email"
                            value="<%= user.email %>"
                            required
                        />
                    </div>
                </div>
                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                    >
                        Скасувати
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>
                        Зберегти зміни
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Обробка форми редагування профілю
    document
        .getElementById('editProfileForm')
        .addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const data = Object.fromEntries(formData);

            try {
                const response = await fetch(`/api/users/<%= user._id %>`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization: `Bearer ${localStorage.getItem(
                            'authToken',
                        )}`,
                    },
                    body: JSON.stringify(data),
                });

                if (response.ok) {
                    location.reload();
                } else {
                    const error = await response.json();
                    alert('Помилка: ' + error.error);
                }
            } catch (error) {
                alert('Сталася помилка при оновленні профілю');
            }
        });
</script>
