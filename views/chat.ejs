<%- include('layout') %>

<div class="row h-100">
    <!-- Бічна панель з користувачами -->
    <div class="col-md-3">
        <div class="card shadow-lg h-100">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-users me-2"></i>
                    Користувачі онлайн
                    <span class="badge bg-success ms-2" id="onlineCount">0</span>
                </h6>
            </div>
            <div class="card-body p-0">
                <div id="usersList" class="list-group list-group-flush">
                    <!-- Користувачі будуть додані динамічно -->
                </div>
            </div>
        </div>
    </div>

    <!-- Головна область чату -->
    <div class="col-md-9">
        <div class="card shadow-lg h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-0">
                        <i class="fas fa-comments me-2"></i>
                        <span id="chatTitle">Загальний чат</span>
                    </h6>
                </div>
                <div>
                    <button class="btn btn-outline-primary btn-sm" id="publicChatBtn">
                        <i class="fas fa-globe me-1"></i>
                        Загальний
                    </button>
                    <div class="btn-group ms-2">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fas fa-cog"></i>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" id="clearChatBtn">Очистити чат</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/profile">Профіль</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Область повідомлень -->
            <div class="card-body d-flex flex-column p-0" style="height: 500px;">
                <div id="messagesContainer" class="flex-grow-1 overflow-auto p-3">
                    <div id="messagesList">
                        <!-- Повідомлення будуть додані динамічно -->
                    </div>
                </div>

                <!-- Форма для відправки повідомлень -->
                <div class="p-3 border-top">
                    <form id="messageForm" class="d-flex">
                        <input
                            type="text"
                            id="messageInput"
                            class="form-control me-2"
                            placeholder="Введіть повідомлення..."
                            maxlength="500"
                            required
                        >
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                    <div class="mt-2">
                        <small class="text-muted">
                            <span id="typingIndicator"></span>
                            <span class="float-end">
                                Натисніть Enter для відправки
                            </span>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Індикатор підключення -->
<div id="connectionStatus" class="position-fixed bottom-0 end-0 m-3">
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-wifi me-2"></i>
        Підключено до чату
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
</div>

<style>
.chat-message {
    margin-bottom: 15px;
}

.message-bubble {
    max-width: 70%;
    padding: 12px 16px;
    border-radius: 18px;
    word-wrap: break-word;
}

.message-own {
    margin-left: auto;
    background: linear-gradient(45deg, #667eea, #764ba2);
    color: white;
}

.message-other {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
}

.message-private {
    border-left: 4px solid #28a745;
}

.message-system {
    text-align: center;
    font-style: italic;
    color: #6c757d;
}

.user-item {
    cursor: pointer;
    transition: all 0.2s ease;
}

.user-item:hover {
    background-color: #f8f9fa;
}
